---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import HomeReviews from '../components/HomeReviews.astro';
import HomeSeo from '../components/HomeSeo.astro';
import HomeAboutApp from '../components/react/HomeAbout';
import SiteFooter from '../components/SiteFooter.astro';
import { getLocaleContent, getPageContent } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import type { LocaleCode } from '../data/i18n/locales';
import { homeFaqs, homeSeo, productInfo, siteConfig, customerReviewStats } from '../data/site';
import { heroPreloadSrc, heroSizes, heroSrcSet } from '../lib/responsive-images';
import { defaultCrawlImageSrc } from '../data/page-images';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const { ui } = getLocaleContent(locale);
const home = getPageContent(locale, 'home');
const enHome = homeSeo();

const title = locale === 'en' ? enHome.title : home.title;
const description = locale === 'en' ? enHome.description : home.description;
const canonicalPath = getLocalizedPath('home', locale);
const canonicalURL = new URL(canonicalPath, siteConfig.url).href;
const heroImage = new URL(siteConfig.defaultOgImage || defaultCrawlImageSrc, siteConfig.url).href;
const priceValidUntil = '2027-12-31';

const aggregateRating = {
	'@type': 'AggregateRating',
	ratingValue: customerReviewStats.averageRating.toFixed(1),
	reviewCount: String(customerReviewStats.totalCount),
	bestRating: '5',
	worstRating: '1',
};

/** One commerce type only — Product. Reviews live on /reviews/. */
const extraGraph: Record<string, unknown>[] = [
	{
		'@type': 'Product',
		'@id': `${canonicalURL}#product`,
		name: productInfo.name,
		description: productInfo.summary,
		image: heroImage,
		brand: { '@type': 'Brand', name: productInfo.brand },
		url: new URL('/wuthering-waves-cheats/', siteConfig.url).href,
		aggregateRating,
		offers: {
			'@type': 'AggregateOffer',
			lowPrice: Math.min(...productInfo.plans.map((p) => p.price)).toFixed(2),
			highPrice: Math.max(...productInfo.plans.map((p) => p.price)).toFixed(2),
			priceCurrency: productInfo.currency,
			offerCount: productInfo.plans.length,
			availability: 'https://schema.org/InStock',
			url: siteConfig.checkoutUrl,
			offers: productInfo.plans.map((plan) => ({
				'@type': 'Offer',
				name: `${productInfo.name} ${plan.label}`,
				price: plan.price.toFixed(2),
				priceCurrency: productInfo.currency,
				priceValidUntil,
				availability: 'https://schema.org/InStock',
				url: siteConfig.checkoutUrl,
				seller: { '@id': `${siteConfig.url}/#organization` },
			})),
		},
	},
	{
		'@type': 'FAQPage',
		'@id': `${canonicalURL}#faq`,
		mainEntity: homeFaqs.map((item) => ({
			'@type': 'Question',
			name: item.question,
			url: `${siteConfig.url}/faq/${item.slug}/`,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.answer,
			},
		})),
	},
];
---

<Layout
	title={title}
	description={description}
	canonicalPath={canonicalPath}
	ogImage={siteConfig.defaultOgImage}
	ogImageAlt={
		home.imageAlt?.trim() && home.imageAlt.trim().length > 12
			? home.imageAlt
			: `${siteConfig.name} — Wuthering Waves ESP and aimbot`
	}
	locale={locale}
	pageId="home"
	breadcrumbs={[{ label: ui.nav.home }]}
	extraGraph={locale === 'en' ? extraGraph : extraGraph.filter((n) => n['@type'] !== 'FAQPage')}
	lcpImage={heroPreloadSrc}
	lcpImageSrcSet={heroSrcSet}
	lcpImageSizes={heroSizes}
>
	<Navbar locale={locale} pageId="home" />
	<main class="home">
		<Hero locale={locale} />
		<HomeReviews locale={locale} />
		<div class="home__seo">
			{
				locale === 'en' ? (
					<>
						<HomeAboutApp client:visible locale={locale} />
						<HomeSeo locale={locale} />
					</>
				) : (
					<div class="shell home__prose">
						<h2>{home.h1}</h2>
						<p>{home.intro}</p>
						{
							home.sections.map((section) => (
								<div>
									<h3>{section.h2}</h3>
									{section.paragraphs.map((p) => (
										<p set:html={p} />
									))}
								</div>
							))
						}
					</div>
				)
			}
		</div>
		<SiteFooter locale={locale} />
	</main>
</Layout>

<style>
	.home {
		width: 100%;
		overflow-x: clip;
	}

	.home__seo {
		border-top: 1px solid var(--line-soft);
		background: var(--bg-panel);
		content-visibility: auto;
		contain-intrinsic-size: 1px 900px;
	}

	.home-about {
		padding-block: clamp(2rem, 4vw, 2.75rem) clamp(1.5rem, 3vw, 2rem);
		border-bottom: 1px solid var(--line-soft);
	}

	.home-about__head {
		margin-bottom: 1.5rem;
		max-width: 42rem;
	}

	.home-about__eyebrow {
		margin: 0 0 0.45rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--magenta);
	}

	.home-about__head h2 {
		margin: 0 0 0.65rem;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.8vw, 1.85rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.2;
		color: var(--ink);
	}

	.home-about__lede {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.65;
		color: var(--ink-muted);
	}

	.home-about__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
		margin-bottom: 1.35rem;
	}

	.home-about__card {
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: color-mix(in srgb, var(--bg-elevated) 85%, transparent);
		overflow: hidden;
		transition: border-color 0.2s ease;
	}

	.home-about__card:hover {
		border-color: color-mix(in srgb, var(--magenta) 35%, var(--line));
	}

	.home-about__card-head {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.85rem 1rem;
		border-bottom: 1px solid var(--line-soft);
		background: color-mix(in srgb, var(--magenta) 8%, var(--bg-panel));
	}

	.home-about__card-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 8px;
		background: color-mix(in srgb, var(--magenta) 18%, transparent);
		color: var(--magenta-soft);
		flex-shrink: 0;
	}

	.home-about__card-icon svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	.home-about__card-head h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--magenta-soft);
	}

	.home-about__list {
		margin: 0;
		padding: 0.65rem 1rem 0.85rem;
		list-style: none;
		display: grid;
		gap: 0.45rem;
	}

	.home-about__list li {
		position: relative;
		padding-left: 1.1rem;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--ink-muted);
	}

	.home-about__list li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--magenta);
		box-shadow: 0 0 6px color-mix(in srgb, var(--magenta) 60%, transparent);
	}

	.home-about__links {
		padding-top: 0.25rem;
	}

	.home-about__links-label {
		margin: 0 0 0.65rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.home-about__links-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.home-about__links-row a {
		display: inline-flex;
		align-items: center;
		min-height: 2.25rem;
		padding: 0.4rem 0.85rem;
		border: 1px solid color-mix(in srgb, var(--magenta) 30%, var(--line));
		border-radius: 6px;
		background: color-mix(in srgb, var(--magenta) 6%, var(--bg-panel));
		color: var(--ink);
		font-size: 0.8125rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			border-color 0.18s ease,
			background 0.18s ease,
			color 0.18s ease;
	}

	.home-about__links-row a:hover {
		border-color: var(--magenta);
		background: color-mix(in srgb, var(--magenta) 14%, var(--bg-panel));
		color: var(--magenta-soft);
	}

	@media (max-width: 900px) {
		.home-about__grid {
			grid-template-columns: 1fr;
		}
	}

	.home__prose {
		padding-block: var(--section-space);
		color: var(--ink-muted);
		line-height: 1.65;
		font-size: 0.9375rem;
	}

	.home__prose--en {
		padding-block: clamp(2rem, 4vw, 2.75rem) 0.5rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home__prose--en a {
		color: var(--magenta-soft);
		font-weight: 600;
		text-decoration: none;
	}

	.home__prose--en a:hover {
		color: var(--ink);
	}

	.home__prose h2 {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-size: 1.5rem;
		letter-spacing: -0.03em;
		color: var(--ink);
	}

	.home__prose h3 {
		margin: 1.25rem 0 0.5rem;
		font-size: 1rem;
		color: var(--ink);
	}
</style>
